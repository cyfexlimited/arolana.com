{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "python manage.py collectstatic --noinput"
  },
  "deploy": {
    "preDeployCommand": "python manage.py migrate --noinput",
    "startCommand": "bash scripts/start-production.sh",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health/"
  }
}
