{% extends "admin/base_site.html" %}
{% load i18n %}

{% block content %}
<style>
.media-progress-table { width: 100%; border-collapse: collapse; margin-top: 18px; }
.media-progress-table th, .media-progress-table td { padding: 9px 10px; border-bottom: 1px solid #ddd; text-align: left; vertical-align: middle; }
.media-thumb { width: 88px; height: 88px; object-fit: contain; background: #fff; border: 1px solid #ddd; border-radius: 6px; }
.status-error { color: #ba2121; }
.status-ok { color: #198754; }
.status-running { color: #b8860b; }
#run-log { white-space: pre-wrap; background: #f6f6f6; border: 1px solid #ddd; padding: 12px; min-height: 60px; margin-top: 14px; }
</style>

<h1>{{ title }}</h1>
<p><strong>Product draft:</strong> {{ item.created_product|default:"-" }}</p>
<p>Each image is generated in its own request so one failure does not discard earlier successful images. Generated images remain review-only and are never published automatically.</p>

<form id="csrf-form" style="display:none;">{% csrf_token %}</form>

<div style="margin:16px 0; display:flex; gap:10px; flex-wrap:wrap;">
    <button type="button" class="button default" id="start-generation">Generate all queued media</button>
    <a class="button" href="{{ review_url }}">Review generated media</a>
    <a class="button" href="{{ change_url }}#import-media-candidates-tab">Back to import item</a>
</div>

<table class="media-progress-table">
    <thead><tr><th>#</th><th>View</th><th>Status</th><th>Attempts</th><th>Preview</th><th>Error</th></tr></thead>
    <tbody>
    {% for candidate in candidates %}
        <tr id="candidate-{{ candidate.pk }}">
            <td>{{ candidate.order }}</td>
            <td>{{ candidate.get_view_role_display }}</td>
            <td class="candidate-status">{{ candidate.get_status_display }}</td>
            <td>{{ candidate.generation_attempts }}</td>
            <td class="candidate-preview">
                {% if candidate.asset_storage_name %}
                    <img class="media-thumb" src="{% url 'admin:catalog_imports_importitem_media_preview' item.pk candidate.pk %}" alt="{{ candidate.get_view_role_display }}">
                {% else %}-{% endif %}
            </td>
            <td class="candidate-error">{{ candidate.last_error|default:"-" }}</td>
        </tr>
    {% empty %}
        <tr><td colspan="6">No generation jobs exist for this item.</td></tr>
    {% endfor %}
    </tbody>
</table>

<div id="run-log">Ready.</div>

<script>
(function(){
    const queue = {{ queue_json|safe }};
    const btn = document.getElementById('start-generation');
    const log = document.getElementById('run-log');
    const csrf = document.querySelector('#csrf-form input[name=csrfmiddlewaretoken]').value;

    function append(message) {
        log.textContent += "\n" + message;
    }

    async function generateOne(job) {
        const row = document.getElementById('candidate-' + job.id);
        const statusCell = row.querySelector('.candidate-status');
        const errorCell = row.querySelector('.candidate-error');
        statusCell.textContent = 'Generating…';
        statusCell.className = 'candidate-status status-running';
        errorCell.textContent = '-';
        append('Generating ' + job.label + '…');
        try {
            const response = await fetch(job.url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {'X-CSRFToken': csrf, 'X-Requested-With': 'XMLHttpRequest'}
            });
            const data = await response.json();
            if (!response.ok || !data.ok) {
                statusCell.textContent = data.status_label || 'Failed';
                statusCell.className = 'candidate-status status-error';
                errorCell.textContent = data.error || 'Generation failed.';
                append('Failed: ' + job.label + ' — ' + (data.error || 'unknown error'));
                return false;
            }
            statusCell.textContent = data.status_label || 'Ready for review';
            statusCell.className = 'candidate-status status-ok';
            if (data.preview_url) {
                row.querySelector('.candidate-preview').innerHTML = '<img class="media-thumb" src="' + data.preview_url + '?v=' + Date.now() + '" alt="preview">';
            }
            append('Generated: ' + job.label);
            return true;
        } catch (err) {
            statusCell.textContent = 'Request failed';
            statusCell.className = 'candidate-status status-error';
            errorCell.textContent = String(err);
            append('Request failed: ' + job.label + ' — ' + String(err));
            return false;
        }
    }

    btn.addEventListener('click', async function(){
        if (!queue.length) {
            append('Nothing is queued. Review existing generated media or retry rejected/failed jobs.');
            return;
        }
        btn.disabled = true;
        log.textContent = 'Starting sequential media generation…';
        for (const job of queue) {
            await generateOne(job);
        }
        append('Queue finished. Open Review generated media to inspect every result before approval.');
        btn.disabled = false;
    });
})();
</script>
{% endblock %}
