{% extends "admin/base_site.html" %}
{% load i18n %}

{% block content %}
<style>
.review-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(310px,1fr)); gap:18px; margin-top:18px; }
.review-card { border:1px solid #ddd; border-radius:8px; padding:14px; background:#fff; }
.review-image-button { width:100%; padding:0; border:0; background:transparent; cursor:zoom-in; text-align:inherit; }
.review-image { width:100%; aspect-ratio:1/1; object-fit:contain; background:#f7f7f7; border:1px solid #eee; border-radius:6px; }
.review-image-button:hover .review-image { outline:2px solid #79aec8; }
.review-zoom-hint { display:block; margin-top:6px; font-size:12px; color:#417690; }
.review-meta { font-size:13px; margin:8px 0; }
.review-check { display:block; margin:7px 0; }
.review-card textarea { width:100%; min-height:60px; }
.review-actions { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }

.compare-modal { display:none; position:fixed; z-index:10050; inset:0; background:rgba(0,0,0,.78); padding:24px; overflow:auto; }
.compare-modal.is-open { display:flex; align-items:flex-start; justify-content:center; }
.compare-shell { width:min(1500px, 96vw); margin:auto; background:#fff; border-radius:10px; box-shadow:0 20px 70px rgba(0,0,0,.45); overflow:hidden; }
.compare-header { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:14px 18px; border-bottom:1px solid #ddd; }
.compare-header h2 { margin:0; }
.compare-close { font-size:28px; line-height:1; min-width:42px; min-height:42px; cursor:pointer; }
.compare-body { display:grid; grid-template-columns:minmax(0, 1.45fr) minmax(320px, .75fr); gap:18px; padding:18px; }
.compare-panel { min-width:0; }
.compare-panel h3 { margin-top:0; }
.compare-generated { width:100%; max-height:78vh; object-fit:contain; background:#f5f5f5; border:1px solid #ddd; border-radius:8px; }
.reference-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:12px; }
.reference-card { border:1px solid #ddd; border-radius:8px; padding:8px; background:#fafafa; }
.reference-card img { width:100%; aspect-ratio:1/1; object-fit:contain; background:#fff; }
.reference-card a { display:block; margin-top:7px; overflow-wrap:anywhere; font-size:12px; }
.compare-note { font-size:13px; color:#555; margin-bottom:12px; }
body.review-modal-open { overflow:hidden; }
@media (max-width: 900px) {
  .compare-body { grid-template-columns:1fr; }
  .compare-modal { padding:8px; }
}
</style>

<h1>{{ title }}</h1>
<p><strong>Product draft:</strong> {{ item.created_product|default:"-" }}</p>
<p>Approval is deliberately human-controlled. Confirm the exact product, watermark-free output, no retailer/source identity, and usage rights before approving any image.</p>

<div style="margin:16px 0; display:flex; gap:10px; flex-wrap:wrap;">
    <a class="button" href="{{ generate_url }}">Generate / retry media</a>
    <a class="button" href="{{ attach_url }}">Attach approved media</a>
    <a class="button" href="{{ change_url }}#import-media-candidates-tab">Back to import item</a>
</div>

<div class="review-grid">
{% for row in rows %}
  {% with candidate=row.candidate %}
  <div class="review-card">
      <h2>{{ candidate.order }}. {{ candidate.get_view_role_display }}</h2>
      {% if row.preview_url %}
        <button type="button" class="review-image-button" data-open-review-modal="compare-{{ candidate.pk }}" aria-label="Open large comparison for {{ candidate.get_view_role_display }}">
          <img class="review-image" src="{{ row.preview_url }}?v={{ candidate.updated_at|date:'U' }}" alt="Generated {{ candidate.get_view_role_display }}">
          <span class="review-zoom-hint">Open large comparison with official manufacturer reference</span>
        </button>
      {% else %}
        <div class="review-image" style="display:flex;align-items:center;justify-content:center;">No generated preview</div>
      {% endif %}
      <div class="review-meta">
        <strong>Status:</strong> {{ candidate.get_status_display }}<br>
        <strong>Provider:</strong> {{ candidate.provider_key|default:"-" }}<br>
        <strong>Attempts:</strong> {{ candidate.generation_attempts }}<br>
        <strong>Resolution:</strong> {% if candidate.width %}{{ candidate.width }} × {{ candidate.height }}{% else %}-{% endif %}<br>
        {% if candidate.last_error %}<strong>Error:</strong> {{ candidate.last_error }}<br>{% endif %}
        {% if candidate.rejection_reason %}<strong>Previous rejection:</strong> {{ candidate.rejection_reason }}{% endif %}
      </div>

      {% if candidate.status == 'ready_review' %}
      <form method="post">
          {% csrf_token %}
          <input type="hidden" name="candidate_id" value="{{ candidate.pk }}">
          <label class="review-check"><input type="checkbox" name="exact_identity_verified"> I visually confirm this is the exact verified product/model.</label>
          <label class="review-check"><input type="checkbox" name="watermark_clear"> I confirm there is no watermark.</label>
          <label class="review-check"><input type="checkbox" name="source_identity_clear"> I confirm there is no Paykobo/retailer/source identity or seller overlay.</label>
          <label class="review-check"><input type="checkbox" name="rights_confirmed"> I confirm this generated output is approved for Arolana product use.</label>
          <textarea name="rejection_reason" placeholder="Reason if rejecting"></textarea>
          <div class="review-actions">
              <button class="button default" type="submit" name="action" value="approve">Approve</button>
              <button class="button" type="submit" name="action" value="reject">Reject</button>
          </div>
      </form>
      {% elif candidate.status == 'approved' %}
        <p><strong>Approved.</strong> Selected for Product attachment.</p>
        <form method="post">{% csrf_token %}<input type="hidden" name="candidate_id" value="{{ candidate.pk }}"><button class="button" type="submit" name="action" value="reject">Reject / remove approval</button></form>
      {% elif candidate.status == 'failed' or candidate.status == 'rejected' %}
        <form method="post">{% csrf_token %}<input type="hidden" name="candidate_id" value="{{ candidate.pk }}"><button class="button" type="submit" name="action" value="retry">Return to generation queue</button></form>
      {% elif candidate.status == 'attached' %}
        <p><strong>Attached to Product gallery.</strong></p>
      {% else %}
        <p>Generate this candidate before review.</p>
      {% endif %}
  </div>

  {% if row.preview_url %}
  <div class="compare-modal" id="compare-{{ candidate.pk }}" role="dialog" aria-modal="true" aria-labelledby="compare-title-{{ candidate.pk }}">
    <div class="compare-shell">
      <div class="compare-header">
        <h2 id="compare-title-{{ candidate.pk }}">{{ candidate.get_view_role_display }} — generated vs official reference</h2>
        <button type="button" class="button compare-close" data-close-review-modal aria-label="Close comparison">×</button>
      </div>
      <div class="compare-body">
        <section class="compare-panel">
          <h3>Generated candidate</h3>
          <p class="compare-note">Inspect physical shape, camera/lens placement, grille pattern, stand/mount, visible branding, buttons, ports and accessories before approving.</p>
          <img class="compare-generated" src="{{ row.preview_url }}?v={{ candidate.updated_at|date:'U' }}" alt="Large generated {{ candidate.get_view_role_display }}">
        </section>
        <section class="compare-panel">
          <h3>Official manufacturer reference — actual references used for this generation</h3>
          {% if row.reference_trace.recorded %}
            <p class="compare-note"><strong>Trace recorded.</strong> These are the exact reference URLs frozen immediately before provider request attempt {{ row.reference_trace.attempt }} ({{ row.reference_trace.provider_key|default:"provider" }}).</p>
          {% else %}
            <p class="compare-note" style="color:#a15c00;"><strong>Legacy candidate:</strong> this image predates Phase 5.0.4 trace locking. The URLs below are the candidate's currently stored references, not an immutable request trace. Regenerate once before final approval if you require a locked audit trail.</p>
          {% endif %}
          <p class="compare-note">Reference-only evidence. These images are never attached to the Product automatically.</p>
          {% if row.reference_urls_used %}
            <div class="reference-grid">
              {% for ref_url in row.reference_urls_used|slice:":3" %}
                <div class="reference-card">
                  <img src="{{ ref_url }}" alt="Official reference used {{ forloop.counter }}" loading="lazy" referrerpolicy="no-referrer">
                  <a href="{{ ref_url }}" target="_blank" rel="noopener noreferrer">Open reference used {{ forloop.counter }}</a>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <p>No official reference URL is recorded for this generation. Do not approve exact identity from this candidate.</p>
          {% endif %}
        </section>
      </div>
    </div>
  </div>
  {% endif %}
  {% endwith %}
{% empty %}
  <p>No generation jobs exist for this item.</p>
{% endfor %}
</div>

<script>
(function () {
  function closeModal(modal) {
    if (!modal) return;
    modal.classList.remove('is-open');
    document.body.classList.remove('review-modal-open');
  }
  document.querySelectorAll('[data-open-review-modal]').forEach(function (button) {
    button.addEventListener('click', function () {
      const modal = document.getElementById(button.getAttribute('data-open-review-modal'));
      if (!modal) return;
      modal.classList.add('is-open');
      document.body.classList.add('review-modal-open');
      const closeButton = modal.querySelector('[data-close-review-modal]');
      if (closeButton) closeButton.focus();
    });
  });
  document.querySelectorAll('[data-close-review-modal]').forEach(function (button) {
    button.addEventListener('click', function () { closeModal(button.closest('.compare-modal')); });
  });
  document.querySelectorAll('.compare-modal').forEach(function (modal) {
    modal.addEventListener('click', function (event) {
      if (event.target === modal) closeModal(modal);
    });
  });
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') closeModal(document.querySelector('.compare-modal.is-open'));
  });
})();
</script>
{% endblock %}
