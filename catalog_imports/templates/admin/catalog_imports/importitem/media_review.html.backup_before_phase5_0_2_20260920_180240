{% extends "admin/base_site.html" %}
{% load i18n %}

{% block content %}
<style>
.review-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(310px,1fr)); gap:18px; margin-top:18px; }
.review-card { border:1px solid #ddd; border-radius:8px; padding:14px; background:#fff; }
.review-image { width:100%; aspect-ratio:1/1; object-fit:contain; background:#f7f7f7; border:1px solid #eee; border-radius:6px; }
.review-meta { font-size:13px; margin:8px 0; }
.review-check { display:block; margin:7px 0; }
.review-card textarea { width:100%; min-height:60px; }
.review-actions { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
</style>

<h1>{{ title }}</h1>
<p><strong>Product draft:</strong> {{ item.created_product|default:"-" }}</p>
<p>Approval is deliberately human-controlled. Confirm the exact product, watermark-free output, no retailer/source identity, and usage rights before approving any image.</p>

<div style="margin:16px 0; display:flex; gap:10px; flex-wrap:wrap;">
    <a class="button" href="{{ generate_url }}">Generate / retry media</a>
    <a class="button" href="{{ attach_url }}">Attach approved media</a>
    <a class="button" href="{{ change_url }}#import-media-candidates-tab">Back to import item</a>
</div>

<div class="review-grid">
{% for row in rows %}
  {% with candidate=row.candidate %}
  <div class="review-card">
      <h2>{{ candidate.order }}. {{ candidate.get_view_role_display }}</h2>
      {% if row.preview_url %}
        <img class="review-image" src="{{ row.preview_url }}?v={{ candidate.updated_at|date:'U' }}" alt="{{ candidate.get_view_role_display }}">
      {% else %}
        <div class="review-image" style="display:flex;align-items:center;justify-content:center;">No generated preview</div>
      {% endif %}
      <div class="review-meta">
        <strong>Status:</strong> {{ candidate.get_status_display }}<br>
        <strong>Provider:</strong> {{ candidate.provider_key|default:"-" }}<br>
        <strong>Attempts:</strong> {{ candidate.generation_attempts }}<br>
        <strong>Resolution:</strong> {% if candidate.width %}{{ candidate.width }} × {{ candidate.height }}{% else %}-{% endif %}<br>
        {% if candidate.last_error %}<strong>Error:</strong> {{ candidate.last_error }}<br>{% endif %}
        {% if candidate.rejection_reason %}<strong>Previous rejection:</strong> {{ candidate.rejection_reason }}{% endif %}
      </div>

      {% if candidate.status == 'ready_review' %}
      <form method="post">
          {% csrf_token %}
          <input type="hidden" name="candidate_id" value="{{ candidate.pk }}">
          <label class="review-check"><input type="checkbox" name="exact_identity_verified"> I visually confirm this is the exact verified product/model.</label>
          <label class="review-check"><input type="checkbox" name="watermark_clear"> I confirm there is no watermark.</label>
          <label class="review-check"><input type="checkbox" name="source_identity_clear"> I confirm there is no Paykobo/retailer/source identity or seller overlay.</label>
          <label class="review-check"><input type="checkbox" name="rights_confirmed"> I confirm this generated output is approved for Arolana product use.</label>
          <textarea name="rejection_reason" placeholder="Reason if rejecting"></textarea>
          <div class="review-actions">
              <button class="button default" type="submit" name="action" value="approve">Approve</button>
              <button class="button" type="submit" name="action" value="reject">Reject</button>
          </div>
      </form>
      {% elif candidate.status == 'approved' %}
        <p><strong>Approved.</strong> Selected for Product attachment.</p>
        <form method="post">{% csrf_token %}<input type="hidden" name="candidate_id" value="{{ candidate.pk }}"><button class="button" type="submit" name="action" value="reject">Reject / remove approval</button></form>
      {% elif candidate.status == 'failed' or candidate.status == 'rejected' %}
        <form method="post">{% csrf_token %}<input type="hidden" name="candidate_id" value="{{ candidate.pk }}"><button class="button" type="submit" name="action" value="retry">Return to generation queue</button></form>
      {% elif candidate.status == 'attached' %}
        <p><strong>Attached to Product gallery.</strong></p>
      {% else %}
        <p>Generate this candidate before review.</p>
      {% endif %}
  </div>
  {% endwith %}
{% empty %}
  <p>No generation jobs exist for this item.</p>
{% endfor %}
</div>
{% endblock %}
